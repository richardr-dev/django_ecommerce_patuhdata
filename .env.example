DEBUG=1
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
# Platform mode: http://localhost:8000 is the landing page and http://<slug>.localhost:8000
# each store (browsers resolve *.localhost to this machine). Empty = single-store mode.
PLATFORM_DOMAIN=localhost
# Address suffix shown to sellers at signup ("<name>.lakuin.store"); links still use localhost.
PLATFORM_DISPLAY_DOMAIN=lakuin.store
# Links people click; PUBLIC_BASE_URL can stay a tunnel (ngrok) for payment webhooks.
PLATFORM_BASE_URL=http://localhost:8000
PLATFORM_NAME=Lakuin
PLATFORM_TAGLINE=Biar Jualan Makin Laku
PLATFORM_COMPANY_NAME=PT Patuhdata Solusi Nusantara
PLATFORM_COMPANY_URL=https://patuhdata.id
PLATFORM_SUPPORT_EMAIL=
# Custom plan contact button, e.g. https://wa.me/62812xxxx (defaults to the support email)
PLATFORM_SALES_URL=
DATABASE_URL=postgresql://commerce:commerce@localhost:5433/commerce
DEFAULT_FROM_EMAIL=orders@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
ADMINS=
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
BITESHIP_API_KEY=
BITESHIP_API_URL=https://api.biteship.com
# PT Patuhdata's own DOKU account: Lakuin subscription billing. Buyers pay each seller's own
# DOKU/Xendit/bank account, set by the seller in back office > Pembayaran.
DOKU_CLIENT_ID=
DOKU_API_KEY=
DOKU_SECRET_KEY=
DOKU_API_URL=https://api-sandbox.doku.com
DOKU_PAYMENT_DUE_MINUTES=60
PAYMENT_PROVIDER=doku
# 1 lets stores without their own account take payments into the platform account above. Keep 0
# unless PT Patuhdata holds a payment licence or a split-payment partner agreement.
PLATFORM_COLLECTS_PAYMENTS=0
# Encrypts sellers' gateway secrets (defaults to SECRET_KEY). Set before ever rotating SECRET_KEY.
PAYMENT_SECRETS_KEY=
BANK_TRANSFER_DUE_HOURS=24
PUBLIC_BASE_URL=http://localhost:8000
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_VERIFICATION_TOKEN=
XENDIT_API_URL=https://api.xendit.co
BITESHIP_ORIGIN_POSTAL_CODE=
BITESHIP_COURIERS=jne,jnt,sicepat,anteraja
BITESHIP_ALLOW_LIVE=0
BITESHIP_ORIGIN_CONTACT_NAME=
BITESHIP_ORIGIN_CONTACT_PHONE=
BITESHIP_ORIGIN_ADDRESS=
SHIPPING_RATE_PROVIDER=biteship
RAJAONGKIR_API_KEY=
RAJAONGKIR_API_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_ORIGIN_ID=
RAJAONGKIR_ORIGIN_POSTAL_CODE=
RAJAONGKIR_COURIERS=jne:sicepat:jnt:ninja:tiki:anteraja:pos
ENGAGEMENT_RETENTION_DAYS=90
MOBILE_TOKEN_TTL_DAYS=30
USE_S3=0
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-southeast-1
AWS_S3_CUSTOM_DOMAIN=
