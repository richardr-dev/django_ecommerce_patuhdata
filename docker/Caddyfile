# SITE_ADDRESS is the platform's own domain(s), e.g. "niagakit.id, www.niagakit.id", whose
# certificates Caddy obtains at start-up; "localhost" uses a local CA.
#
# Store subdomains (<slug>.niagakit.id) and sellers' custom domains are served by the
# catch-all block below: Caddy obtains each certificate on the first visit, but only after
# Django's /internal/tls-ask/ confirms the host belongs to an active store.
{
	on_demand_tls {
		ask http://web:8000/internal/tls-ask/
	}
}

(app) {
	encode zstd gzip

	# Product photos, logos and banners are public uploads; serve them without Django.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}

{$SITE_ADDRESS} {
	import app
}

https:// {
	tls {
		on_demand
	}
	import app
}

http:// {
	redir https://{host}{uri} permanent
}
