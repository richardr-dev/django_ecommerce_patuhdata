# Copy to .env.production and fill in. Never commit the filled-in file.

# Self-serve platform: sellers sign up at https://lakuin.store/start/ and get
# https://<slug>.lakuin.store. DNS: A records for lakuin.store, www.lakuin.store and
# *.lakuin.store (wildcard) pointing at this server. Leave empty for a single brand.
PLATFORM_DOMAIN=lakuin.store
PLATFORM_NAME=Lakuin
PLATFORM_TAGLINE=Biar Jualan Makin Laku
PLATFORM_COMPANY_NAME=PT Patuhdata Solusi Nusantara
PLATFORM_COMPANY_URL=https://patuhdata.id
PLATFORM_SUPPORT_EMAIL=halo@lakuin.store
# Custom plan contact button, e.g. https://wa.me/62812xxxx (defaults to the support email)
PLATFORM_SALES_URL=
# Subscriptions: free trial for new stores; renewal bills go out this many days before a
# period ends (emailed, so set up SMTP above), with a grace period for paying sellers.
TRIAL_DAYS=14
RENEWAL_NOTICE_DAYS=7
RENEWAL_GRACE_DAYS=3

# The platform's own domains, with certificates at start-up (comma-separated). Store
# subdomains and custom domains get on-demand certificates; see docker/Caddyfile.
# www redirects to the apex. Use "localhost" (and PLATFORM_DOMAIN=) for a local trial.
SITE_ADDRESS=lakuin.store, www.lakuin.store
# Recommended: one wildcard certificate for every store subdomain, so new stores have HTTPS
# instantly and signups never hit Let's Encrypt's 50-certificates-a-week limit. Create a
# Cloudflare API token (template "Edit zone DNS", zone lakuin.store), then set both:
CLOUDFLARE_API_TOKEN=
# CADDYFILE=Caddyfile.wildcard
# Hosts Django accepts. Sellers' custom domains are not known in advance, so platform mode
# uses "*": the store resolver then rejects any host that is not the platform, a store
# subdomain, or a store's custom domain. Single-brand mode: list the domains instead.
ALLOWED_HOSTS=*
# The platform's own address. Set the DOKU notification URL in the DOKU dashboard to
# https://lakuin.store/integrations/webhooks/doku/
PUBLIC_BASE_URL=https://lakuin.store

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# 1 creates the demo store on an empty database (handy for a trial; leave 0 for real launches).
SEED_DEMO=0
GUNICORN_WORKERS=3
# 31536000 once every domain is confirmed HTTPS-only.
SECURE_HSTS_SECONDS=0

# Error tracking (sentry.io or self-hosted). Empty disables it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# "Name:email" receives a traceback email for every server error.
ADMINS=

# Daily database + media backups to BACKUP_DIR on the host; copy them off the server too.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

DEFAULT_FROM_EMAIL=Lakuin <no-reply@lakuin.store>
# Console prints emails to the worker log; switch to smtp and fill the EMAIL_* values to send.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Buyers pay each seller's own bank account or DOKU/Xendit account (back office > Pembayaran).
# The DOKU keys below are PT Patuhdata's own account, used for Lakuin subscription billing.
# Keep PLATFORM_COLLECTS_PAYMENTS=0 unless PT Patuhdata holds a payment licence or a
# split-payment partner agreement. ALLOW_DEMO_PAYMENTS=1 only for a throwaway trial.
PLATFORM_COLLECTS_PAYMENTS=0
# Encrypts sellers' gateway secrets. Generate once, keep it safe, never change it:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PAYMENT_SECRETS_KEY=
BANK_TRANSFER_DUE_HOURS=24
DOKU_CLIENT_ID=
DOKU_API_KEY=
DOKU_SECRET_KEY=
DOKU_API_URL=https://api-sandbox.doku.com
# Shipping rates and booking (Biteship). Empty uses the store's flat-rate methods.
BITESHIP_API_KEY=
BITESHIP_ORIGIN_POSTAL_CODE=
# Uploaded images in the platform S3 bucket (stack output StorageBucketName), under media/.
# Credentials come from the server's instance role; no access keys needed.
USE_S3=1
AWS_STORAGE_BUCKET_NAME=lakuin-storage-<aws-account-id>
AWS_S3_REGION_NAME=ap-southeast-3
