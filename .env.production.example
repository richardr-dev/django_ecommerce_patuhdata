# Copy to .env.production and fill in. Never commit the filled-in file.

# Domains Caddy serves with HTTPS (comma-separated). Use "localhost" for a local trial.
SITE_ADDRESS=localhost
# Same hosts for Django; a leading dot allows subdomains.
ALLOWED_HOSTS=localhost
PUBLIC_BASE_URL=https://localhost

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# 1 creates the demo store on an empty database (handy for a trial; leave 0 for real launches).
SEED_DEMO=0
GUNICORN_WORKERS=3
# 31536000 once every domain is confirmed HTTPS-only.
SECURE_HSTS_SECONDS=0

# Error tracking (sentry.io or self-hosted). Empty disables it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# "Name:email" receives a traceback email for every server error.
ADMINS=

# Daily database + media backups to BACKUP_DIR on the host; copy them off the server too.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

DEFAULT_FROM_EMAIL=orders@example.com
# Console prints emails to the worker log; switch to smtp and fill the EMAIL_* values to send.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Payments (DOKU primary). Leave DOKU_CLIENT_ID empty to use the demo payment page.
DOKU_CLIENT_ID=
DOKU_API_KEY=
DOKU_SECRET_KEY=
DOKU_API_URL=https://api-sandbox.doku.com
# Shipping rates and booking (Biteship). Empty uses the store's flat-rate methods.
BITESHIP_API_KEY=
BITESHIP_ORIGIN_POSTAL_CODE=
